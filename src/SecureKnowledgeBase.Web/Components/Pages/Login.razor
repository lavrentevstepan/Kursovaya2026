@page "/login"
@rendermode InteractiveServer
@inject IAuthenticationService AuthService
@inject CurrentUserService CurrentUserService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Авторизация | SecureKnowledgeBase</PageTitle>

<div class="login-container">
    <div style="text-align: center; margin-bottom: 24px;">
        <div class="brand-logo" style="margin: 0 auto 12px auto;">SKB</div>
        <h1 style="font-size: 20px; font-weight: 700; color: #ffffff;">Вход в SecureKnowledgeBase</h1>
        <p style="font-size: 13px; color: var(--text-secondary); margin-top: 4px;">Учебная локальная аутентификация</p>
    </div>

    @if (CurrentUserService.IsAuthenticated)
    {
        <div class="active-session-banner">
            <div class="active-session-header">
                <span style="font-size: 18px;">✅</span>
                <strong>Вы уже авторизованы в системе</strong>
            </div>
            <div class="active-session-body">
                <div>Профиль: <strong>@CurrentUserService.DisplayName</strong></div>
                <div style="font-size: 12px; color: var(--text-secondary); margin-top: 2px;">
                    Роль: <span class="badge @GetRoleBadgeClass(CurrentUserService.Role)">@GetRoleTitle(CurrentUserService.Role)</span>
                    • Допуск: @GetAccessLevelTitle(CurrentUserService.MaxAllowedAccessLevel)
                </div>
            </div>
            <div class="active-session-footer">
                <button type="button" class="btn btn-sm btn-outline" @onclick="HandleLogoutSession">
                    Выйти и сменить пользователя
                </button>
                <a href="" class="btn btn-sm btn-primary">
                    В дашборд
                </a>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div style="background-color: var(--danger-bg); border: 1px solid var(--danger); color: #fca5a5; padding: 10px 14px; border-radius: var(--radius-sm); font-size: 13px; margin-bottom: 16px;">
            @_errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div style="background-color: var(--success-bg); border: 1px solid var(--success); color: #86efac; padding: 10px 14px; border-radius: var(--radius-sm); font-size: 13px; margin-bottom: 16px;">
            @_successMessage
        </div>
    }

    <form @onsubmit="HandleLogin">
        <div class="form-group">
            <label class="form-label" for="username">Имя пользователя</label>
            <input id="username" class="form-control" @bind="_username" placeholder="admin, auditor или user" />
        </div>

        <div class="form-group">
            <label class="form-label" for="password">Пароль</label>
            <input id="password" type="password" class="form-control" @bind="_password" placeholder="Введите пароль" />
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 8px;">
            Войти в систему
        </button>
    </form>

    <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-subtle);">
        <span style="font-size: 12px; color: var(--text-muted); display: block; text-align: center; margin-bottom: 10px;">
            Быстрый вход под тестовыми ролями:
        </span>
        <div class="demo-account-grid">
            <button type="button" class="demo-btn" @onclick='() => SelectDemoUser("admin", "AdminPass123!")'>
                <span class="demo-name">admin</span>
                <span class="demo-role">Администратор</span>
            </button>
            <button type="button" class="demo-btn" @onclick='() => SelectDemoUser("auditor", "AuditorPass123!")'>
                <span class="demo-name">auditor</span>
                <span class="demo-role">Аудитор ИБ</span>
            </button>
            <button type="button" class="demo-btn" @onclick='() => SelectDemoUser("user", "UserPass123!")'>
                <span class="demo-name">user</span>
                <span class="demo-role">Пользователь</span>
            </button>
        </div>
    </div>
</div>

@code {
    private string _username = string.Empty;
    private string _password = string.Empty;
    private string? _errorMessage;
    private string? _successMessage;

    private async Task HandleLogin()
    {
        _errorMessage = null;
        _successMessage = null;

        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))
        {
            _errorMessage = "Укажите имя пользователя и пароль";
            return;
        }

        var result = await AuthService.AuthenticateAsync(new LoginRequestDto
        {
            Username = _username,
            Password = _password
        });

        if (result.IsSuccess && result.User != null)
        {
            CurrentUserService.SetUser(result.User.Id, result.User.Username, result.User.DisplayName, result.User.Role);

            try
            {
                var payload = System.Text.Json.JsonSerializer.Serialize(new
                {
                    userId = result.User.Id,
                    username = result.User.Username,
                    displayName = result.User.DisplayName,
                    role = result.User.Role.ToString()
                });
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "skb_session", payload);
            }
            catch {}

            _successMessage = $"Успешный вход: {result.User.DisplayName} ({result.User.Role})";
            await Task.Delay(400);
            NavigationManager.NavigateTo("");
        }
        else
        {
            _errorMessage = result.ErrorMessage ?? "Ошибка аутентификации";
        }
    }

    private async Task HandleLogoutSession()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "skb_session");
        }
        catch {}

        CurrentUserService.ClearUser();
        StateHasChanged();
    }

    private async Task SelectDemoUser(string user, string pass)
    {
        _username = user;
        _password = pass;
        await HandleLogin();
    }

    private string GetRoleBadgeClass(SecureKnowledgeBase.Domain.Enums.UserRole? role)
    {
        return role switch
        {
            SecureKnowledgeBase.Domain.Enums.UserRole.SystemAdmin => "badge-admin",
            SecureKnowledgeBase.Domain.Enums.UserRole.SecurityAuditor => "badge-auditor",
            SecureKnowledgeBase.Domain.Enums.UserRole.KnowledgeAdmin => "badge-knowledge",
            _ => "badge-user"
        };
    }

    private string GetRoleTitle(SecureKnowledgeBase.Domain.Enums.UserRole? role)
    {
        return role switch
        {
            SecureKnowledgeBase.Domain.Enums.UserRole.SystemAdmin => "Администратор",
            SecureKnowledgeBase.Domain.Enums.UserRole.SecurityAuditor => "Аудитор ИБ",
            SecureKnowledgeBase.Domain.Enums.UserRole.KnowledgeAdmin => "Редактор БЗ",
            SecureKnowledgeBase.Domain.Enums.UserRole.User => "Пользователь",
            _ => "Гость"
        };
    }

    private string GetAccessLevelTitle(SecureKnowledgeBase.Domain.Enums.AccessLevel level)
    {
        return level switch
        {
            SecureKnowledgeBase.Domain.Enums.AccessLevel.Confidential => "Секретно (3)",
            SecureKnowledgeBase.Domain.Enums.AccessLevel.Restricted => "ДСП (2)",
            _ => "Внутренний (1)"
        };
    }
}
