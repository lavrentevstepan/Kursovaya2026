@inherits LayoutComponentBase
@implements IDisposable
@inject CurrentUserService CurrentUserService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<div class="app-layout">
    <aside class="sidebar">
        <NavMenu OnOpenStats="OpenProjectStats" />
    </aside>

    <div class="main-wrapper">
        <header class="topbar">
            <div class="topbar-left">
                <span class="system-status-indicator">
                    <span class="status-dot healthy"></span>
                    <span>API активен</span>
                </span>
                <span class="badge badge-db">SQLite FTS5</span>
                <span class="badge badge-sec">Безопасный режим</span>
            </div>

            <div class="topbar-right">
                @if (CurrentUserService.IsAuthenticated)
                {
                    <div class="user-profile-card">
                        <span class="user-avatar-badge @GetRoleAvatarClass(CurrentUserService.Role)">
                            @GetRoleIcon(CurrentUserService.Role)
                        </span>
                        <div class="user-meta-info">
                            <div class="user-name-line">
                                <span class="user-display-name">@CurrentUserService.DisplayName</span>
                                <span class="user-handle">(@CurrentUserService.Username)</span>
                            </div>
                            <div class="user-badges-line">
                                <span class="badge @GetRoleBadgeClass(CurrentUserService.Role)">
                                    @GetRoleTitle(CurrentUserService.Role)
                                </span>
                                <span class="badge badge-access-level">
                                    @GetAccessLevelTitle(CurrentUserService.MaxAllowedAccessLevel)
                                </span>
                            </div>
                        </div>
                        <button class="btn btn-sm btn-logout" @onclick="HandleLogout" title="Выйти из текущего профиля">
                            <span>Выйти</span>
                            <span style="font-size: 14px;">➔</span>
                        </button>
                    </div>
                }
                else
                {
                    <div class="user-guest-card">
                        <span class="guest-avatar">👤</span>
                        <div class="guest-info">
                            <span class="guest-title">Гостевой режим</span>
                            <span class="guest-sub">Авторизация не выполнена</span>
                        </div>
                        <a href="login" class="btn btn-sm btn-primary btn-login-nav">Войти в систему</a>
                    </div>
                }
            </div>
        </header>

        <main class="content-area">
            @Body
        </main>

        <footer class="app-footer-bar">
            <div class="footer-left">
                <span class="footer-tag">SecureKnowledgeBase</span>
                <span class="footer-separator">•</span>
                <span class="footer-note">Курсовой проект DevSecOps (Вариант 25, Студент: Лаврентьев С. А.)</span>
            </div>
            <div class="footer-right">
                <span class="footer-version">v1.0.0 • Вариант 25</span>
                <button class="footer-info-btn" @onclick="OpenProjectStats" title="Паспорт проекта и статистика кодовой базы" aria-label="Информация о проекте">
                    ℹ️
                </button>
            </div>
        </footer>
    </div>

    @if (_showProjectStats)
    {
        <div class="modal-backdrop-custom" @onclick="CloseProjectStats">
            <div class="modal-dialog-custom" style="max-width: 840px;" @onclick:stopPropagation="true">
                <div class="modal-header-custom" style="display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; border-bottom: 1px solid #293548; background: #161f2e;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <span style="font-size: 24px;">📊</span>
                        <div>
                            <h3 style="margin: 0; color: #38bdf8; font-size: 18px; font-weight: 700;">Паспорт проекта и статистика кодовой базы</h3>
                            <p style="margin: 2px 0 0 0; color: #94a3b8; font-size: 12px;">SecureKnowledgeBase • DevSecOps Курсовой проект (Вариант 25, Студент: Лаврентьев С. А.)</p>
                        </div>
                    </div>
                    <button style="background: transparent; border: none; color: #94a3b8; font-size: 20px; cursor: pointer; line-height: 1; padding: 4px;" @onclick="CloseProjectStats">✕</button>
                </div>

                <div class="modal-body-custom" style="padding: 24px; overflow-y: auto; max-height: 70vh; display: flex; flex-direction: column; gap: 20px;">
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px;">
                        <div style="background: #0f172a; padding: 14px; border-radius: 8px; border: 1px solid #1e293b; text-align: center;">
                            <div style="font-size: 11px; color: #94a3b8; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em;">Объем кодовой базы</div>
                            <div style="font-size: 24px; font-weight: 800; color: #38bdf8; margin-top: 4px;">12,805</div>
                            <div style="font-size: 11px; color: #64748b;">строк кода (160 файлов)</div>
                        </div>
                        <div style="background: #0f172a; padding: 14px; border-radius: 8px; border: 1px solid #1e293b; text-align: center;">
                            <div style="font-size: 11px; color: #94a3b8; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em;">Backend & Frontend</div>
                            <div style="font-size: 24px; font-weight: 800; color: #10b981; margin-top: 4px;">7,148</div>
                            <div style="font-size: 11px; color: #64748b;">C# (4,608) + Razor (2,540)</div>
                        </div>
                        <div style="background: #0f172a; padding: 14px; border-radius: 8px; border: 1px solid #1e293b; text-align: center;">
                            <div style="font-size: 11px; color: #94a3b8; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em;">Автоматизация DevSecOps</div>
                            <div style="font-size: 24px; font-weight: 800; color: #a855f7; margin-top: 4px;">2,053</div>
                            <div style="font-size: 11px; color: #64748b;">PowerShell, IaC, CI/CD</div>
                        </div>
                        <div style="background: #0f172a; padding: 14px; border-radius: 8px; border: 1px solid #1e293b; text-align: center;">
                            <div style="font-size: 11px; color: #94a3b8; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em;">Unit-тестирование</div>
                            <div style="font-size: 24px; font-weight: 800; color: #10b981; margin-top: 4px;">55 / 55</div>
                            <div style="font-size: 11px; color: #10b981;">100% пройдены (0 ошибок)</div>
                        </div>
                    </div>

                    <div style="background: #0f172a; border: 1px solid #1e293b; border-radius: 8px; padding: 18px;">
                        <h4 style="margin: 0 0 12px 0; font-size: 14px; color: #f8fafc; font-weight: 600;">Детализация структуры кодовой базы по компонентам</h4>
                        <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                            <thead>
                                <tr style="border-bottom: 1px solid #334155; color: #94a3b8; text-align: left;">
                                    <th style="padding: 8px 10px;">Компонент / Язык</th>
                                    <th style="padding: 8px 10px;">Файлы</th>
                                    <th style="padding: 8px 10px;">Строк кода (SLOC)</th>
                                    <th style="padding: 8px 10px;">Назначение в архитектуре</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="border-bottom: 1px solid #1e293b;">
                                    <td style="padding: 8px 10px;"><strong style="color: #60a5fa;">C# Backend (.cs)</strong></td>
                                    <td style="padding: 8px 10px;">90</td>
                                    <td style="padding: 8px 10px; font-weight: 600;">4,608</td>
                                    <td style="padding: 8px 10px; color: #94a3b8;">Domain модели, Application сервисы, Infrastructure адаптеры, Web API</td>
                                </tr>
                                <tr style="border-bottom: 1px solid #1e293b;">
                                    <td style="padding: 8px 10px;"><strong style="color: #34d399;">Blazor UI (.razor)</strong></td>
                                    <td style="padding: 8px 10px;">15</td>
                                    <td style="padding: 8px 10px; font-weight: 600;">2,540</td>
                                    <td style="padding: 8px 10px; color: #94a3b8;">Интерактивные страницы, дашборд, поиск, чат ассистента, аудит</td>
                                </tr>
                                <tr style="border-bottom: 1px solid #1e293b;">
                                    <td style="padding: 8px 10px;"><strong style="color: #c084fc;">DevSecOps Automation (.ps1)</strong></td>
                                    <td style="padding: 8px 10px;">10</td>
                                    <td style="padding: 8px 10px; font-weight: 600;">1,631</td>
                                    <td style="padding: 8px 10px; color: #94a3b8;">Единый лаунчер, оркестрация сканеров, генерация SBOM и подпись Cosign</td>
                                </tr>
                                <tr style="border-bottom: 1px solid #1e293b;">
                                    <td style="padding: 8px 10px;"><strong style="color: #f59e0b;">IaC Terraform (.tf)</strong></td>
                                    <td style="padding: 8px 10px;">6</td>
                                    <td style="padding: 8px 10px; font-weight: 600;">173</td>
                                    <td style="padding: 8px 10px; color: #94a3b8;">Конфигурации 4 узлов ВМ, бастиона, сети и стенд дефектов bad_infra</td>
                                </tr>
                                <tr style="border-bottom: 1px solid #1e293b;">
                                    <td style="padding: 8px 10px;"><strong style="color: #f43f5e;">CI/CD & Policies (.yml / .yaml)</strong></td>
                                    <td style="padding: 8px 10px;">4</td>
                                    <td style="padding: 8px 10px; font-weight: 600;">249</td>
                                    <td style="padding: 8px 10px; color: #94a3b8;">GitHub Actions пайплайн, конфигурация Dependabot, локальные правила Falco</td>
                                </tr>
                                <tr style="border-bottom: 1px solid #1e293b;">
                                    <td style="padding: 8px 10px;"><strong style="color: #38bdf8;">Стилизация и UI Tokens (.css)</strong></td>
                                    <td style="padding: 8px 10px;">2</td>
                                    <td style="padding: 8px 10px; font-weight: 600;">781</td>
                                    <td style="padding: 8px 10px; color: #94a3b8;">Дизайн-система, переменные темной темы, адаптивные сетки, анимации</td>
                                </tr>
                                <tr>
                                    <td style="padding: 8px 10px;"><strong style="color: #94a3b8;">Документация и отчеты (.md)</strong></td>
                                    <td style="padding: 8px 10px;">25</td>
                                    <td style="padding: 8px 10px; font-weight: 600;">2,615</td>
                                    <td style="padding: 8px 10px; color: #94a3b8;">Архитектурные паспорта M1–M11, модель угроз STRIDE, регламент SAMM</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>


                </div>

                <div class="modal-footer-custom" style="display: flex; justify-content: space-between; align-items: center; padding: 16px 24px; border-top: 1px solid #293548; background: #161f2e;">
                    <span style="font-size: 12px; color: #64748b;">SecureKnowledgeBase • Версия 1.0.0</span>
                    <button style="padding: 8px 20px; font-size: 13px; font-weight: 600; border-radius: 6px; background: #222d3e; border: 1px solid #3b82f6; color: #93c5fd; cursor: pointer;" @onclick="CloseProjectStats">
                        Закрыть
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool _showProjectStats = false;

    private void OpenProjectStats()
    {
        _showProjectStats = true;
    }

    private void CloseProjectStats()
    {
        _showProjectStats = false;
    }

    protected override void OnInitialized()
    {
        CurrentUserService.OnChange += HandleStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !CurrentUserService.IsAuthenticated)
        {
            try
            {
                var sessionJson = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "skb_session");
                if (!string.IsNullOrWhiteSpace(sessionJson))
                {
                    var doc = System.Text.Json.JsonDocument.Parse(sessionJson);
                    var root = doc.RootElement;
                    var userId = root.GetProperty("userId").GetGuid();
                    var username = root.GetProperty("username").GetString()!;
                    var displayName = root.GetProperty("displayName").GetString()!;
                    var role = Enum.Parse<SecureKnowledgeBase.Domain.Enums.UserRole>(root.GetProperty("role").GetString()!);

                    CurrentUserService.SetUser(userId, username, displayName, role);
                    StateHasChanged();
                }
            }
            catch {}
        }
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleLogout()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "skb_session");
        }
        catch {}

        CurrentUserService.ClearUser();
        NavigationManager.NavigateTo("login");
    }

    private string GetRoleIcon(SecureKnowledgeBase.Domain.Enums.UserRole? role)
    {
        return role switch
        {
            SecureKnowledgeBase.Domain.Enums.UserRole.SystemAdmin => "👑",
            SecureKnowledgeBase.Domain.Enums.UserRole.SecurityAuditor => "🛡️",
            SecureKnowledgeBase.Domain.Enums.UserRole.KnowledgeAdmin => "📚",
            _ => "👤"
        };
    }

    private string GetRoleAvatarClass(SecureKnowledgeBase.Domain.Enums.UserRole? role)
    {
        return role switch
        {
            SecureKnowledgeBase.Domain.Enums.UserRole.SystemAdmin => "avatar-admin",
            SecureKnowledgeBase.Domain.Enums.UserRole.SecurityAuditor => "avatar-auditor",
            SecureKnowledgeBase.Domain.Enums.UserRole.KnowledgeAdmin => "avatar-knowledge",
            _ => "avatar-user"
        };
    }

    private string GetRoleBadgeClass(SecureKnowledgeBase.Domain.Enums.UserRole? role)
    {
        return role switch
        {
            SecureKnowledgeBase.Domain.Enums.UserRole.SystemAdmin => "badge-admin",
            SecureKnowledgeBase.Domain.Enums.UserRole.SecurityAuditor => "badge-auditor",
            SecureKnowledgeBase.Domain.Enums.UserRole.KnowledgeAdmin => "badge-knowledge",
            _ => "badge-user"
        };
    }

    private string GetRoleTitle(SecureKnowledgeBase.Domain.Enums.UserRole? role)
    {
        return role switch
        {
            SecureKnowledgeBase.Domain.Enums.UserRole.SystemAdmin => "Администратор",
            SecureKnowledgeBase.Domain.Enums.UserRole.SecurityAuditor => "Аудитор ИБ",
            SecureKnowledgeBase.Domain.Enums.UserRole.KnowledgeAdmin => "Редактор БЗ",
            SecureKnowledgeBase.Domain.Enums.UserRole.User => "Пользователь",
            _ => "Гость"
        };
    }

    private string GetAccessLevelTitle(SecureKnowledgeBase.Domain.Enums.AccessLevel level)
    {
        return level switch
        {
            SecureKnowledgeBase.Domain.Enums.AccessLevel.Confidential => "Секретно (3)",
            SecureKnowledgeBase.Domain.Enums.AccessLevel.Restricted => "ДСП (2)",
            _ => "Внутренний (1)"
        };
    }

    public void Dispose()
    {
        CurrentUserService.OnChange -= HandleStateChanged;
    }
}
